meta {
  name: 17 Pasar solicitud de Ana a revision
  type: http
  seq: 17
}

patch {
  url: {{baseUrl}}/api/solicitudes/{{solicitudAnaId}}/estado
  body: json
  auth: none
}

headers {
  X-Rol: COORDINADOR
  X-Usuario: laura
}

body:json {
  {
    "estado": "EN_REVISION"
  }
}

assert {
  res.status: eq 200
}
