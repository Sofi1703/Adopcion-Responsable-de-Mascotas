meta {
  name: 09 Crear solicitud de Carlos
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/solicitudes-adopcion
  body: json
  auth: none
}

body:json {
  {
    "mascotaId": {{mascotaId}},
    "solicitanteNombre": "Carlos Ruiz",
    "solicitanteCorreo": "carlos@correo.com",
    "telefono": "3204445566"
  }
}

vars:post-response {
  solicitudCarlosId: res.body.id
}

assert {
  res.status: eq 201
}
