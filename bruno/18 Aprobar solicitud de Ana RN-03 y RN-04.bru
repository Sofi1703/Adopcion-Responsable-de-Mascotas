meta {
  name: 18 Aprobar solicitud de Ana (RN-03 y RN-04)
  type: http
  seq: 18
}

patch {
  url: {{baseUrl}}/api/solicitudes/{{solicitudAnaId}}/estado
  body: json
  auth: none
}

headers {
  X-Rol: COORDINADOR
  X-Usuario: laura
}

body:json {
  {
    "estado": "APROBADA"
  }
}

assert {
  res.status: eq 200
  res.body.mascotaEstado: eq ADOPTADA
}
