meta {
  name: 07 Crear solicitud de Ana
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/solicitudes-adopcion
  body: json
  auth: none
}

body:json {
  {
    "mascotaId": {{mascotaId}},
    "solicitanteNombre": "Ana Pérez",
    "solicitanteCorreo": "ana@correo.com",
    "telefono": "3103334455"
  }
}

vars:post-response {
  solicitudAnaId: res.body.id
}

assert {
  res.status: eq 201
}
