meta {
  name: 01 Crear mascota
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/mascotas
  body: json
  auth: none
}

headers {
  X-Rol: FUNDACION
  X-Usuario: fundacion
}

body:json {
  {
    "nombre": "Nala",
    "especie": "Gato",
    "raza": null,
    "descripcion": "Cariñosa y curiosa",
    "imagenUrl": "https://ejemplo.com/nala.jpg"
  }
}

vars:post-response {
  mascotaId: res.body.id
}

assert {
  res.status: eq 201
}
